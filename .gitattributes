# 统一行尾为 LF，避免 Windows / 其他平台来回改文件
* text=auto eol=lf

# 源码与文档
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.mjs   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制：不让 git 尝试合并或转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.wav   binary
*.zip   binary
*.exe   binary

# 原作文本是 UTF-16 LE，禁止行尾转换与 diff 尝试
local_docs/*.txt -text -diff

# 文档里的截图不参与 diff 统计
docs/screens/*.png binary
